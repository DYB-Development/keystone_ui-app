<!DOCTYPE html>
<html <%= helpers.keystone_theme_attributes %> class="<%= class_names(dark: dark_mode?, "hotwire-native": native_app?) %>" lang="<%= I18n.locale %>">
  <head>
    <%= tag.meta name: "viewport", content: viewport %>
    <%= tag.style(NATIVE_APP_STYLE.html_safe) if native_app? %>
    <%= head %>
  </head>
  <%= tag.body(**body) do %>
    <header>
      <%= flash %>
      <% if phone_avatar_shown? %>
        <%= tag.div(class: PHONE_AVATAR_ROW) do %>
          <%= tag.div(phone_menus, class: "min-w-0 flex-1") %>
          <%= link_to account_page.href_for(helpers), class: "shrink-0", aria: { label: "Account" } do %>
            <%= render KeystoneUi::App::AvatarComponent.new %>
          <% end %>
        <% end %>
      <% elsif phone_menus? && !native_app? %>
        <%= tag.div(phone_menus, class: PHONE_ONLY) %>
      <% end %>
      <% if phone_header_shown? %>
        <%= helpers.ui_mobile_header(title: page_signalled(:title), back_url: page_signalled(:back_url), subtitle: page_signalled(:subtitle)) %>
      <% elsif !native_app? %>
        <%= render KeystoneUi::App::SectionMenuComponent.new %>
      <% end %>
      <%= render KeystoneUi::App::PageActionsComponent.new unless native_app? %>
    </header>
    <% page = tag.main { safe_join([content, (footer if footer_shown?)]) } %>
    <% if native_app? %>
      <%= render KeystoneUi::App::NativeMenuButtonComponent.new %>
      <%= render KeystoneUi::App::NativeAddButtonComponent.new %>
      <%= page %>
    <% else %>
      <%= helpers.ui_navigation do |navigation| %>
        <% navigation.with_logo { logo.to_s } if logo? %>
        <% if account_menu? %>
          <% navigation.with_menus { render KeystoneUi::App::AccountMenuComponent.new } %>
        <% elsif menus? %>
          <% navigation.with_menus { menus.to_s } %>
        <% end %>
        <%= page %>
      <% end %>
    <% end %>
    <%= render KeystoneUi::App::BottomTabsComponent.new if bottom_tabs_shown? %>
  <% end %>
</html>
