<%= form_with(url: helpers.request.path, method: :get, data: { controller: "auto-submit", action: "input->auto-submit#submit", turbo_frame: FRAME }) do %>
  <%= render Keystone::Ui::InputComponent.new(name: "find", type: :text, value: find, placeholder: "Find a page", autocomplete: "off") %>
<% end %>

<%= helpers.turbo_frame_tag FRAME, target: "_top" do %>
  <% if rows.empty? && find.present? %>
    <p class="ks-text-muted">No page matches “<%= find %>”.</p>
  <% end %>
  <% rows.each do |row| %>
    <% if row.pages %>
      <%= render Keystone::Ui::DisclosureComponent.new(open: find.present?) do |disclosure| %>
        <% disclosure.with_summary { row.href ? link_to(row.label, row.href) : row.label } %>
        <%= render Keystone::Ui::LinkListComponent.new(rows: row.pages) %>
      <% end %>
    <% else %>
      <%= render Keystone::Ui::LinkListComponent.new(rows: [ { label: row.label, href: row.href } ]) %>
    <% end %>
  <% end %>
<% end %>
