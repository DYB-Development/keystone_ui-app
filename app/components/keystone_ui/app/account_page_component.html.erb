<section>
  <%= render Keystone::Ui::SectionComponent.new do %>
    <div class="<%= PERSON_CLASSES %>">
      <%= render KeystoneUi::App::AvatarComponent.new %>
      <div class="min-w-0 flex-1">
        <span class="<%= NAME_CLASSES %>"><%= person[:name] %></span>
        <span class="<%= EMAIL_CLASSES %>"><%= person[:email] %></span>
      </div>
    </div>
  <% end %>
</section>
